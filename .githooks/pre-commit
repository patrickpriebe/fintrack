#!/bin/sh
# =============================================================================
# Local barrier against credential leaks.
#
# Enable locally with:
#   git config core.hooksPath .githooks
#
# Inspects STAGED file contents (`git diff --cached`) for common credential patterns.
# =============================================================================

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

matched_kind=''
check_file() {
    file="$1"
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        kind=${line%%|*}
        pattern=${line#*|}
        if git show ":$file" 2>/dev/null | grep -Eq -e "$pattern"; then
            matched_kind="$kind"
            return 0
        fi
    done <<'PATTERNS'
chave secreta Stripe|sk_(live|test)_[0-9a-zA-Z]{20}
segredo de webhook Stripe|whsec_[0-9a-zA-Z]{20}
token do GitHub|(ghp_|github_pat_)[0-9a-zA-Z_]{20}
chave de acesso AWS|AKIA[0-9A-Z]{16}
URI do MongoDB com senha|mongodb\+srv://[^<$"'[:space:]]+:[^@$"'[:space:]]+@
URL do Postgres com senha|postgres(ql)?://[^<$"'[:space:]]+:[^@$"'[:space:]]+@
chave privada|BEGIN [A-Z ]*PRIVATE KEY
token do Slack|xox[baprs]-[0-9a-zA-Z]{10}
PATTERNS
    return 1
}

found=0
for file in $staged; do
    case "$file" in
        .env.example|*/.env.example|.githooks/pre-commit|.github/scripts/scan-secrets.sh) continue ;;
    esac

    if check_file "$file"; then
        echo "BLOQUEADO: '$file' contém o que parece ser uma $matched_kind"
        found=1
    fi
done

if [ "$found" -ne 0 ]; then
    cat <<'EOF'

Commit interrompido. Credenciais em repositório não devem ser commitadas.
Remova os valores reais, aponte para variáveis de ambiente no .env e tente novamente.
Se for um falso positivo intencional: git commit --no-verify
EOF
    exit 1
fi

exit 0
