# Normalise line endings so the repo behaves identically across Windows, Linux and macOS.
* text=auto eol=lf

# Scripts that run inside Linux containers MUST keep LF to avoid "/bin/bash^M: bad interpreter".
*.sh   text eol=lf

# Windows-specific scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binaries
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.zip  binary
*.phar binary
